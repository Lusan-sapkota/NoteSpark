{
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "types": [
      "vite/client"
    ],
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@notespark/core": [
        "../packages/core/src/index.ts"
      ],
      "@notespark/sync": [
        "../packages/sync/src/index.ts"
      ],
      "better-sqlite3-multiple-ciphers": [
        "./node_modules/better-sqlite3-multiple-ciphers/index.d.ts"
      ],
      "expo-sqlite": [
        "./src/main/shims/expo-sqlite.ts"
      ],
      "expo-crypto": [
        "./src/main/shims/expo-crypto.ts"
      ],
      "expo-secure-store": [
        "./src/main/shims/expo-secure-store.ts"
      ],
      "expo-local-authentication": [
        "./src/main/shims/expo-local-authentication.ts"
      ],
      "expo-file-system/legacy": [
        "./src/main/shims/expo-file-system-legacy.ts"
      ],
      "@react-native-async-storage/async-storage": [
        "./src/main/shims/async-storage.ts"
      ],
      "react-native": [
        "./src/main/shims/react-native.ts"
      ],
      "expo-asset": [
        "./src/main/shims/expo-asset.ts"
      ],
      "onnxruntime-react-native": [
        "./node_modules/onnxruntime-node"
      ]
    },
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": [
    "src",
    "electron.vite.config.ts",
    "../packages/core/src",
    "../packages/sync/src",
    "../Mobile/src/storage/crdt.ts",
    "../Mobile/src/storage/database.ts",
    "../Mobile/src/storage/notes.ts",
    "../Mobile/src/storage/profiles.ts",
    "../Mobile/src/storage/autoBackup.ts",
    "../Mobile/src/storage/semanticSearch.ts"
  ],
  "exclude": [
    "src/renderer/app"
  ]
}