{
  "compilerOptions": {
    "strict": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "types": [
      "vite/client"
    ],
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@notespark/core": [
        "../packages/core/src/index.ts"
      ],
      "better-sqlite3-multiple-ciphers": [
        "./node_modules/better-sqlite3-multiple-ciphers/index.d.ts"
      ]
    },
    "jsx": "react-jsx"
  },
  "include": [
    "src",
    "electron.vite.config.ts",
    "../packages/core/src"
  ],
  "exclude": [
    "src/renderer/spike"
  ]
}