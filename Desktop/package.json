{
  "name": "notespark-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "NoteSpark for desktop",
  "author": "Lusan Sapkota",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --linux AppImage"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "allowScripts": {
    "electron-winstaller": false
  },
  "homepage": "https://github.com/Lusan-Sapkota/NoteSpark",
  "build": {
    "appId": "dev.notespark.desktop",
    "productName": "NoteSpark",
    "files": [
      "out/**",
      "resources/icon.png"
    ],
    "electronLanguages": [
      "en-US"
    ],
    "npmRebuild": false,
    "asar": true,
    "publish": null,
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "resources/icon.png",
      "maintainer": "Lusan Sapkota <lusan@aigeeks.dev>"
    }
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native-paper": "5.15.3",
    "react-native-web": "0.21.4"
  }
}
