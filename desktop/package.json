{
  "name": "notespark-desktop",
  "version": "1.2.0",
  "private": true,
  "description": "NoteSpark for desktop",
  "author": "Lusan Sapkota",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "check:copy": "node scripts/check-copy.mjs",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --linux AppImage",
    "dist:linux": "electron-vite build && electron-builder --linux AppImage deb rpm tar.gz"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "allowScripts": {
    "electron-winstaller": false,
    "onnxruntime-node": false
  },
  "homepage": "https://github.com/Lusan-Sapkota/NoteSpark",
  "build": {
    "appId": "dev.notespark.desktop",
    "productName": "NoteSpark",
    "files": [
      "out/**",
      "resources/icon.png",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/arm64/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/x64/libonnxruntime_providers_*.so",
      "!node_modules/onnxruntime-node/script/**",
      "!node_modules/adm-zip/**",
      "!node_modules/global-agent/**",
      "!node_modules/better-sqlite3-multiple-ciphers/{deps,src,build}/**",
      "!node_modules/better-sqlite3-multiple-ciphers/prebuilds/{darwin,win32,linuxmusl,linux-arm64}*"
    ],
    "electronLanguages": [
      "en-US"
    ],
    "npmRebuild": false,
    "asar": true,
    "publish": null,
    "linux": {
      "artifactName": "NoteSpark-linux-x64.${ext}",
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "tar.gz"
      ],
      "category": "Office",
      "icon": "resources/icon.png",
      "maintainer": "Lusan Sapkota <lusan@aigeeks.dev>",
      "executableName": "notespark",
      "synopsis": "Fast, offline-first notes",
      "description": "NoteSpark keeps your notes on your computer, with no account and no update check. The .deb and .rpm packages also add NoteSpark's package repository (https://packages-notespark.lusansapkota.com.np) so that apt or dnf can offer new versions. Remove it by deleting /etc/apt/sources.list.d/notespark.sources or /etc/yum.repos.d/notespark.repo, or by uninstalling the package.",
      "appArmorProfile": "packaging/apparmor/notespark"
    },
    "asarUnpack": [
      "node_modules/onnxruntime-node/bin/**",
      "node_modules/sqlite-vec-*/**",
      "node_modules/better-sqlite3-multiple-ciphers/prebuilds/**"
    ],
    "extraResources": [
      {
        "from": "../mobile/assets/models",
        "to": "models",
        "filter": [
          "all-MiniLM-L6-v2-int8.onnx",
          "all-MiniLM-L6-v2-vocab.txt"
        ]
      },
      {
        "from": "packaging/linux/notespark-archive-key.asc",
        "to": "notespark-archive-key.asc"
      }
    ],
    "compression": "normal",
    "deb": {
      "afterInstall": "packaging/linux/after-install.sh",
      "afterRemove": "packaging/linux/after-remove.sh"
    },
    "rpm": {
      "afterInstall": "packaging/linux/after-install.sh",
      "afterRemove": "packaging/linux/after-remove.sh"
    }
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "fflate": "0.8.3",
    "mermaid": "12.2.0",
    "onnxruntime-node": "1.24.3",
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native-markdown-display": "7.0.2",
    "react-native-paper": "5.15.3",
    "react-native-web": "0.21.4",
    "sqlite-vec": "0.1.9"
  }
}
