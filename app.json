{
  "expo": {
    "name": "NoteSpark",
    "slug": "notespark",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ef5821"
      },
      "package": "com.lusansapkota.notespark"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ef5821"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c86c2cb6-77d2-46f6-bda0-2fde1df96924"
      }
    },
    "owner": "lusansapkota",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c86c2cb6-77d2-46f6-bda0-2fde1df96924"
    }
  }
}
