{
  "expo": {
    "name": "NoteSpark",
    "slug": "notespark",
    "scheme": "notespark",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#d7eb9b"
      },
      "package": "com.lusansapkota.notespark"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-sqlite",
        {
          "withSQLiteVecExtension": true,
          "useSQLCipher": true
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#546524"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#fbfaee",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#12140d"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "./plugins/withAppCategory",
        "productivity"
      ],
      "expo-asset",
      "onnxruntime-react-native",
      "expo-secure-store",
      "expo-share-intent",
      [
        "expo-quick-actions",
        {
          "androidIcons": {
            "new_note": {
              "foregroundImage": "./assets/shortcut-new-note.png",
              "backgroundColor": "#d7eb9b"
            }
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c86c2cb6-77d2-46f6-bda0-2fde1df96924"
      }
    },
    "owner": "lusansapkota"
  }
}
